[
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "DSH Desktop 主窗口默认权限",
    "windows": ["main"],
    "permissions": [
      "core:default",
      "autostart:default"
    ]
  },
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "splash",
    "description": "启动动画窗口：监听 splash-status 事件 + 调用 splash_retry/open_sidecar_log/quit_app",
    "windows": ["splash"],
    "permissions": [
      "core:default"
    ]
  },
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "notify-window",
    "description": "通知弹窗窗口（右下角 notify-*）：提供关闭按钮所需的 IPC",
    "windows": ["notify-*"],
    "permissions": [
      "core:default"
    ]
  },
  {
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "pet",
    "description": "3D 桌面宠物窗口：调用 dsh_rpc/dsh_subscribe/dsh_unsubscribe 驱动内置 DSH 会话",
    "windows": ["pet"],
    "permissions": [
      "core:default",
      "core:event:default",
      "core:window:allow-start-dragging"
    ]
  }
]
